{
  "name": "@norbert-fila/react-generative-visual",
  "version": "0.1.1",
  "description": "Deterministic generative visuals for React.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nubet/react-generative-visual.git"
  },
  "homepage": "https://github.com/Nubet/react-generative-visual#readme",
  "bugs": {
    "url": "https://github.com/Nubet/react-generative-visual/issues"
  },
  "keywords": [
    "react",
    "svg",
    "generative-art",
    "visual",
    "deterministic"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets/readme-banner.jpg"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "format:demo": "prettier --write \"demo/**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "latest",
    "prettier": "3.9.9",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
